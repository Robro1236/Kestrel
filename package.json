{
  "name": "kestrel",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export -p web",
    "smoke": "node --env-file=.env scripts/smoke-lookup.mjs",
    "load": "node --env-file=.env scripts/load-lookup.mjs",
    "check:fast": "tsc --noEmit && node scripts/floor-guard.mjs",
    "check:task": "npm run check:fast && jest",
    "check:full": "npm run check:task && npm audit --omit=dev --audit-level=high && expo export -p web && node scripts/bundle-size.mjs dist 450"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
